{
	"name": "web",
	"version": "0.0.1",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "dotenv -e .env.local -- sh -c \"NODE_OPTIONS='--import ./instrument.server.mjs' vite dev --port 3000\"",
		"build": "vite build && cp instrument.server.mjs .output/server",
		"preview": "vite preview",
		"lint": "eslint --fix",
		"format": "prettier --write .",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"start": "node --import ./.output/server/instrument.server.mjs .output/server/index.mjs"
	},
	"dependencies": {
		"@clerk/tanstack-react-start": "^1.7.11",
		"@clerk/ui": "^1.42.4",
		"@convex-dev/react-query": "^0.1.0",
		"@posthog/react": "^1.11.3",
		"@repo/constants": "workspace:*",
		"@repo/domain": "workspace:*",
		"@repo/ui": "workspace:*",
		"@sentry/tanstackstart-react": "^11.11.0",
		"@t3-oss/env-core": "^0.13.11",
		"@tailwindcss/vite": "^4.3.5",
		"@tanstack/react-devtools": "^0.10.14",
		"@tanstack/react-query": "^5.107.1",
		"@tanstack/react-router": "^1.170.46",
		"@tanstack/react-router-devtools": "^1.167.3",
		"@tanstack/react-router-ssr-query": "^1.167.3",
		"@tanstack/react-start": "^1.169.5",
		"@tanstack/router-plugin": "^1.169.0",
		"convex": "^1.49.0",
		"dotenv-cli": "^11.1.0",
		"lucide-react": "^1.70.0",
		"nitro": "3.0.261103-rc",
		"posthog-js": "^1.447.6",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tailwindcss": "^4.3.5",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@rsbuild/core": "^2.3.1",
		"@tanstack/devtools-vite": "^0.8.6",
		"@tanstack/eslint-config": "^0.5.0",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitejs/plugin-react": "^6.3.0",
		"eslint": "^10.14.0",
		"jsdom": "^31.0.0",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"vite": "^8.3.7",
		"vitest": "^5.1.0"
	}
}
